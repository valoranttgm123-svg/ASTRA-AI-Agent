# ASTRA runtime configuration
# Copy to .env.local for local development. Never commit real secrets.

ASTRA_PROVIDER=mock
ASTRA_MODEL=
ASTRA_BASE_URL=
ASTRA_API_KEY=

# Hermes Agent local gateway (Brain V1 Phase 2)
# Hermes gateway default API server: http://127.0.0.1:8642
ASTRA_HERMES_ENABLED=true
ASTRA_HERMES_URL=http://127.0.0.1:8642
ASTRA_HERMES_API_KEY=
ASTRA_HERMES_MODEL=hermes-agent
ASTRA_HERMES_TIMEOUT_MS=45000
ASTRA_HERMES_STATUS_TIMEOUT_MS=1200

# Ollama local model fallback (Brain V1 Phase 3)
ASTRA_OLLAMA_ENABLED=true
ASTRA_OLLAMA_URL=http://127.0.0.1:11434
# Leave blank to auto-select the first installed Ollama model.
ASTRA_OLLAMA_MODEL=
ASTRA_OLLAMA_TIMEOUT_MS=60000
ASTRA_OLLAMA_STATUS_TIMEOUT_MS=1200

# Optional future integrations
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL=

# Safety defaults
ASTRA_REQUIRE_APPROVAL=true
ASTRA_ALLOW_SHELL=false
ASTRA_ALLOW_FILE_WRITE=false
ASTRA_ALLOW_EXTERNAL_ACTIONS=false
