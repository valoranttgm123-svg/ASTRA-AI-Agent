# ASTRA runtime configuration
# Copy to .env.local for local development. Never commit real secrets.

# Hermes Agent local gateway
ASTRA_HERMES_ENABLED=true
ASTRA_HERMES_URL=http://127.0.0.1:8642
ASTRA_HERMES_API_KEY=
ASTRA_HERMES_MODEL=hermes-agent
ASTRA_HERMES_TIMEOUT_MS=45000
ASTRA_HERMES_STATUS_TIMEOUT_MS=1200

# Ollama local model fallback
ASTRA_OLLAMA_ENABLED=true
ASTRA_OLLAMA_URL=http://127.0.0.1:11434
# Leave blank to auto-select the first installed Ollama model.
ASTRA_OLLAMA_MODEL=
ASTRA_OLLAMA_TIMEOUT_MS=60000
ASTRA_OLLAMA_STATUS_TIMEOUT_MS=1200
# Fast Jarvis-style replies by default. Enable extended thinking only when needed.
ASTRA_OLLAMA_THINKING=false
ASTRA_OLLAMA_MAX_TOKENS=1024

# Codex engineering specialist
# Uses the local Codex CLI and its existing authenticated ChatGPT/Codex session.
ASTRA_CODEX_ENABLED=true
ASTRA_CODEX_COMMAND=codex
ASTRA_CODEX_WORKDIR=
ASTRA_CODEX_MODEL=
ASTRA_CODEX_TIMEOUT_MS=180000
ASTRA_CODEX_STATUS_TIMEOUT_MS=2500
# read-only is always allowed; workspace-write is honored only when ASTRA_ALLOW_FILE_WRITE=true.
ASTRA_CODEX_SANDBOX=read-only
# Some managed Codex installations allow only read-only or danger-full-access.
# Danger mode removes the OS-enforced workspace boundary. It requires all three:
# ASTRA_CODEX_SANDBOX=danger-full-access
# ASTRA_CODEX_ALLOW_DANGER_FULL_ACCESS=true
# ASTRA_ALLOW_FILE_WRITE=true and ASTRA_ALLOW_SHELL=true
ASTRA_CODEX_ALLOW_DANGER_FULL_ACCESS=false
# Private local memory is NOT sent to Codex unless explicitly enabled.
ASTRA_CODEX_INCLUDE_MEMORY=false

# Durable local memory / skills
# Private runtime files belong under .astra/ (gitignored).
ASTRA_MEMORY_ENABLED=true
ASTRA_MEMORY_FILE=.astra/memory.json
ASTRA_MEMORY_MAX_ENTRIES=6
ASTRA_MEMORY_MAX_CHARS=4200
ASTRA_SKILLS_ENABLED=true
ASTRA_SKILLS_FILE=.astra/skills.json

# Optional OpenAI-compatible cloud fallback.
# Disabled by default. It will not run unless BOTH flags below are true.
ASTRA_CLOUD_ENABLED=false
ASTRA_ALLOW_PAID_CLOUD=false
ASTRA_CLOUD_URL=
ASTRA_CLOUD_API_KEY=
ASTRA_CLOUD_MODEL=
ASTRA_CLOUD_TIMEOUT_MS=60000
ASTRA_CLOUD_STATUS_TIMEOUT_MS=2500
# Private local memory is NOT sent to cloud unless explicitly enabled.
ASTRA_CLOUD_INCLUDE_MEMORY=false

# Optional future integrations
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL=

# ASTRA permission policy
# Safe defaults are read-only. For local workspace execution, keep approval on
# and enable only the permissions you need. You can use:
#   powershell -ExecutionPolicy Bypass -File .\scripts\enable-local-execution.ps1
# This enables local file/shell execution for Codex but keeps external actions
# and paid cloud disabled.
ASTRA_REQUIRE_APPROVAL=true
ASTRA_ALLOW_SHELL=false
ASTRA_ALLOW_FILE_WRITE=false
ASTRA_ALLOW_EXTERNAL_ACTIONS=false
