# ASTRA runtime configuration
# Copy to .env.local for local development. Never commit real secrets.

ASTRA_PROVIDER=mock
ASTRA_MODEL=
ASTRA_BASE_URL=
ASTRA_API_KEY=

# Hermes Agent local gateway (Brain V1 Phase 2)
# Hermes gateway default API server: http://127.0.0.1:8642
ASTRA_HERMES_ENABLED=true
ASTRA_HERMES_URL=http://127.0.0.1:8642
ASTRA_HERMES_API_KEY=
ASTRA_HERMES_MODEL=hermes-agent
ASTRA_HERMES_TIMEOUT_MS=45000
ASTRA_HERMES_STATUS_TIMEOUT_MS=1200
# Explicit opt-in after reviewing the gateway's own tool permissions.
# Each Hermes turn still requires a one-time confirmation in ASTRA.
ASTRA_HERMES_AGENT_APPROVAL=false

# Ollama local model fallback (Brain V1 Phase 3)
ASTRA_OLLAMA_ENABLED=true
ASTRA_OLLAMA_URL=http://127.0.0.1:11434
# Leave blank to auto-select the first installed Ollama model.
ASTRA_OLLAMA_MODEL=
ASTRA_OLLAMA_TIMEOUT_MS=60000
ASTRA_OLLAMA_STATUS_TIMEOUT_MS=1200
# Fast Jarvis-style replies by default. Enable extended thinking only when needed.
ASTRA_OLLAMA_THINKING=false
ASTRA_OLLAMA_MAX_TOKENS=1024

# Codex CLI uses an existing ChatGPT login, never a paid API-key fallback.
# Command must be an executable (not a shell script/.cmd shim on Windows).
ASTRA_CODEX_ENABLED=false
ASTRA_CODEX_COMMAND=codex
ASTRA_CODEX_TIMEOUT_MS=180000
ASTRA_ALLOW_CODEX_WRITE=false

# Optional project allowlist. Default: current ASTRA working directory.
# ASTRA_PROJECTS=[{"id":"astra","name":"ASTRA","root":"D:/Projects/ASTRA-AI-Agent"}]

# Optional MCP Streamable HTTP servers, disabled when list is empty.
# Only server-listed tools may run. readOnly defaults false (requires approval).
# tokenEnv names an already-configured server environment variable; never paste tokens here.
ASTRA_MCP_SERVERS=[]
ASTRA_MCP_ALLOW_REMOTE=false
# Example local server, with read-only explicit permission:
# ASTRA_MCP_SERVERS=[{"id":"local","url":"http://127.0.0.1:9000/mcp","tools":[{"name":"search","readOnly":true}]}]

# Optional future integrations
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL=

# Safety defaults
ASTRA_REQUIRE_APPROVAL=true
ASTRA_ALLOW_SHELL=false
ASTRA_ALLOW_FILE_WRITE=false
ASTRA_ALLOW_EXTERNAL_ACTIONS=false
