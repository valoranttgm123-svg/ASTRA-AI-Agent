# ASTRA runtime configuration
# Copy to .env.local for local development. Never commit real secrets.

# Hermes Agent local gateway
ASTRA_HERMES_ENABLED=true
ASTRA_HERMES_URL=http://127.0.0.1:8642
ASTRA_HERMES_API_KEY=
# Optional existing local gateway key file. Its contents never enter telemetry.
ASTRA_HERMES_API_KEY_FILE=
# Use "runs" for the official cancellable Agent API with a reviewed read-only
# Sonor-only profile; leave blank for the legacy chat-completions adapter.
ASTRA_HERMES_TRANSPORT=
ASTRA_HERMES_PROFILE=
ASTRA_HERMES_SONOR_MCP_SCRIPT=
ASTRA_HERMES_READONLY_REVIEWED=false
ASTRA_HERMES_MODEL=hermes-agent
ASTRA_HERMES_TIMEOUT_MS=45000
ASTRA_HERMES_STATUS_TIMEOUT_MS=1200

# Ollama local model fallback
ASTRA_OLLAMA_ENABLED=true
ASTRA_OLLAMA_URL=http://127.0.0.1:11434
# Leave blank to auto-select the first installed Ollama model.
ASTRA_OLLAMA_MODEL=
ASTRA_OLLAMA_TIMEOUT_MS=60000
ASTRA_OLLAMA_STATUS_TIMEOUT_MS=1200
# Fast Jarvis-style replies by default. Enable extended thinking only when needed.
ASTRA_OLLAMA_THINKING=false
ASTRA_OLLAMA_MAX_TOKENS=1024

# Codex engineering specialist
# Uses the local Codex CLI and its existing authenticated ChatGPT/Codex session.
ASTRA_AUTO_PROVIDER=
ASTRA_CODEX_ENABLED=true
ASTRA_CODEX_COMMAND=codex
ASTRA_CODEX_WORKDIR=
ASTRA_CODEX_MODEL=
# Opt-in: omit unrelated user MCP/config startup; an explicit model is required.
ASTRA_CODEX_ISOLATE_CONFIG=false
ASTRA_CODEX_TIMEOUT_MS=180000
ASTRA_CODEX_STATUS_TIMEOUT_MS=2500
# read-only is always allowed; workspace-write is honored only when ASTRA_ALLOW_FILE_WRITE=true.
ASTRA_CODEX_SANDBOX=read-only
# Some managed Codex installations allow only read-only or danger-full-access.
# Danger mode removes the OS-enforced workspace boundary. It requires all three:
# ASTRA_CODEX_SANDBOX=danger-full-access
# ASTRA_CODEX_ALLOW_DANGER_FULL_ACCESS=true
# ASTRA_ALLOW_FILE_WRITE=true and ASTRA_ALLOW_SHELL=true
ASTRA_CODEX_ALLOW_DANGER_FULL_ACCESS=false
# Private local memory is NOT sent to Codex unless explicitly enabled.
ASTRA_CODEX_INCLUDE_MEMORY=false

# Durable local memory / skills
# Private runtime files belong under .astra/ (gitignored).
ASTRA_MEMORY_ENABLED=true
ASTRA_MEMORY_FILE=.astra/memory.json
ASTRA_MEMORY_MAX_ENTRIES=6
ASTRA_MEMORY_MAX_CHARS=4200
ASTRA_SKILLS_ENABLED=true
ASTRA_SKILLS_FILE=.astra/skills.json

# Explicit registered project context. Read-only and no directory scanning.
# Only project.docs / project.importantFiles under the registered workspace are eligible.
ASTRA_PROJECT_CONTEXT_ENABLED=true
ASTRA_PROJECT_CONTEXT_MAX_FILES=20
ASTRA_PROJECT_CONTEXT_MAX_FILE_BYTES=262144

# Existing local Sonor workflow/knowledge graph.
# Sonor already aggregates Graphify/Obsidian/project context on this PC.
# Keep ASTRA-to-Sonor traffic on loopback; do not use the LAN-facing Sonor URL here.
ASTRA_SONOR_ENABLED=false
ASTRA_SONOR_URL=http://127.0.0.1:55127
# Configure only after the real Sonor endpoint contract is inspected.
# Recommended ASTRA-compatible bridge contract: POST JSON -> { "records": AstraMemoryRecord[] }
ASTRA_SONOR_SEARCH_PATH=
ASTRA_SONOR_TIMEOUT_MS=4000

# Public-web research
# browser.fetch can read an explicit public http/https URL without a search provider.
# Full research.search/research.web needs a local SearXNG JSON search endpoint.
# Keep it loopback-only; ASTRA refuses non-loopback SearXNG endpoints.
# Example: http://127.0.0.1:8080/search
ASTRA_SEARXNG_URL=

# Optional OpenAI-compatible cloud fallback.
# Disabled by default. It will not run unless BOTH flags below are true.
ASTRA_CLOUD_ENABLED=false
ASTRA_ALLOW_PAID_CLOUD=false
ASTRA_CLOUD_URL=
ASTRA_CLOUD_API_KEY=
ASTRA_CLOUD_MODEL=
ASTRA_CLOUD_TIMEOUT_MS=60000
ASTRA_CLOUD_STATUS_TIMEOUT_MS=2500
# Private local memory is NOT sent to cloud unless explicitly enabled.
ASTRA_CLOUD_INCLUDE_MEMORY=false

# NVIDIA Build / NIM — adaptive JARVIS-style reasoning model mesh.
# Keep the API key only in .env.local. Free endpoint availability/quotas are controlled by NVIDIA.
ASTRA_NVIDIA_ENABLED=false
NVIDIA_API_KEY=
ASTRA_NVIDIA_URL=https://integrate.api.nvidia.com/v1
# Smart router profiles:
# Chief: hardest planning/reasoning/strategy.
ASTRA_NVIDIA_MODEL_CHIEF=nvidia/nemotron-3-ultra-550b-a55b
# Deep: coding/research/long-horizon agentic reasoning.
ASTRA_NVIDIA_MODEL_DEEP=z-ai/glm-5-3
# Fast: routine conversation and sub-agent work.
ASTRA_NVIDIA_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
# Vision: multimodal reasoning when ASTRA actually supplies visual content.
ASTRA_NVIDIA_MODEL_VISION=z-ai/glm-5-3-flash
# Compatibility alias for Chief only. Leave blank unless overriding the Chief model.
ASTRA_NVIDIA_MODEL=
# auto | chief | deep | fast | vision
ASTRA_NVIDIA_ROUTER_MODE=auto
# Enables supported Nemotron reasoning mode. Does not grant tool execution.
ASTRA_NVIDIA_THINKING=true
ASTRA_NVIDIA_TIMEOUT_MS=90000
ASTRA_NVIDIA_STATUS_TIMEOUT_MS=3500
# AUTO remains local-first. Enable only if ASTRA may fall back to NVIDIA
# after local providers are unavailable.
ASTRA_NVIDIA_AUTO_FALLBACK=false
# Private local/Sonor/project memory is NOT sent to NVIDIA unless explicitly enabled.
ASTRA_NVIDIA_INCLUDE_MEMORY=false

# NVIDIA Skill Hub private state/cache (gitignored under .astra/ by default).
# These files contain catalog/install-state metadata only, never provider secrets.
ASTRA_NVIDIA_SKILL_CATALOG_FILE=.astra/nvidia-skill-catalog.json
ASTRA_NVIDIA_SKILL_REGISTRY_FILE=.astra/nvidia-skills.json


# Durable Background Task Manager private state.
ASTRA_TASK_FILE=.astra/tasks.json

# Proactive Event Engine private state (gitignored under .astra/ by default).
ASTRA_EVENT_FILE=.astra/events.json

# Read-only GitHub Actions -> Event Engine source adapter.
# OFF by default. Public repositories can be read without a token.
# Private repositories use GITHUB_TOKEN below and require Actions: read.
ASTRA_GITHUB_EVENTS_ENABLED=false
ASTRA_GITHUB_EVENTS_REPOSITORY=valoranttgm123-svg/ASTRA-AI-Agent
ASTRA_GITHUB_EVENTS_TIMEOUT_MS=5000
ASTRA_GITHUB_EVENTS_PER_PAGE=20

# Phase 28 private audit history (gitignored under .astra/ by default).
ASTRA_AUDIT_FILE=.astra/audit.json

# Phase 22 trusted-device metadata only. Never store secret values here.
ASTRA_TRUST_FILE=.astra/trust.json

# Phase 27 paired-device metadata only; transport credentials belong in the secret provider.
ASTRA_DEVICE_FILE=.astra/devices.json

# Phase 29 generic skill/environment registries contain metadata only, never secret values.
ASTRA_GENERIC_SKILL_REGISTRY_FILE=.astra/generic-skills.json
ASTRA_ENVIRONMENT_REGISTRY_FILE=.astra/environment-devices.json

# Safe scheduled automation
# Definitions/store may exist while the background service remains OFF.
ASTRA_AUTOMATION_ENABLED=true
ASTRA_AUTOMATION_FILE=.astra/automations.json
# Explicit opt-in only. When true, the existing ASTRA-Agent server process
# runs a single-flight timer for Permission Level 0/1 occurrences.
ASTRA_AUTOMATION_SERVICE_ENABLED=false
ASTRA_AUTOMATION_SERVICE_POLL_MS=60000

# Optional future integrations
# Optional for public GitHub event sources; keep private-repo tokens local only.
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL=

# ASTRA permission policy
# Safe defaults are read-only. For local workspace execution, keep approval on
# and enable only the permissions you need. You can use:
#   powershell -ExecutionPolicy Bypass -File .\scripts\enable-local-execution.ps1
# This enables local file/shell execution for Codex but keeps external actions
# and paid cloud disabled.
ASTRA_REQUIRE_APPROVAL=true
ASTRA_ALLOW_SHELL=false
ASTRA_ALLOW_FILE_WRITE=false
ASTRA_ALLOW_EXTERNAL_ACTIONS=false
