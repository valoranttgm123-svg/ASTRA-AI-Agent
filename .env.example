# ASTRA runtime configuration
# Copy to .env.local for local development. Never commit real secrets.

ASTRA_PROVIDER=mock
ASTRA_MODEL=
ASTRA_BASE_URL=
ASTRA_API_KEY=

# Optional future integrations
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL=

# Safety defaults
ASTRA_REQUIRE_APPROVAL=true
ASTRA_ALLOW_SHELL=false
ASTRA_ALLOW_FILE_WRITE=false
ASTRA_ALLOW_EXTERNAL_ACTIONS=false
